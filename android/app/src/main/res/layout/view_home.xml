<?xml version="1.0" encoding="utf-8"?>
<!--
  The home screen, after Steam Link's: a title, round settings and help buttons in the corner, one
  big tile to start, and a line for each thing that has to be ready, each with its own tick.

  It covers the stream rather than replacing it, and swallows touches, so nothing reaches the
  touchpad or the on-screen controller underneath while it is up.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/home_margin"
        android:layout_marginTop="26dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="@dimen/home_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/home_tagline" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="28dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/ChipButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/helpButton"
            style="@style/ChipButton"
            android:layout_marginStart="14dp"
            android:contentDescription="@string/help"
            android:src="@drawable/ic_help" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="@dimen/home_margin"
        android:layout_marginTop="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/startTile"
            android:layout_width="@dimen/tile_width"
            android:layout_height="@dimen/tile_height"
            android:background="@drawable/tile"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/tile_circle"
                android:layout_height="@dimen/tile_circle">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/white_circle" />

                <ImageView
                    android:id="@+id/startIcon"
                    android:layout_width="@dimen/tile_icon"
                    android:layout_height="@dimen/tile_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play"
                    app:tint="@color/tile" />
            </FrameLayout>

            <TextView
                android:id="@+id/startLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/start_playing"
                android:textColor="@color/text"
                android:textSize="@dimen/tile_label"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/rows_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/rows_gap"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowCard"
                style="@style/HomeRow">

                <ImageView
                    style="@style/HomeRowIcon"
                    android:src="@drawable/ic_videocam" />

                <TextView
                    android:id="@+id/labelCard"
                    style="@style/HomeRowLabel"
                    android:text="@string/no_card" />

                <ImageView
                    android:id="@+id/statusCard"
                    style="@style/HomeRowStatus"
                    android:contentDescription="@string/card_ready" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowPeer"
                style="@style/HomeRow">

                <ImageView
                    style="@style/HomeRowIcon"
                    android:src="@drawable/ic_desktop" />

                <TextView
                    android:id="@+id/labelPeer"
                    style="@style/HomeRowLabel"
                    android:text="@string/no_peer" />

                <ImageView
                    android:id="@+id/statusPeer"
                    style="@style/HomeRowStatus"
                    android:contentDescription="@string/pc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowInput"
                style="@style/HomeRow">

                <ImageView
                    android:id="@+id/iconInput"
                    style="@style/HomeRowIcon"
                    android:src="@drawable/ic_mouse" />

                <TextView
                    android:id="@+id/labelInput"
                    style="@style/HomeRowLabel"
                    android:text="@string/mode_touch" />

                <ImageView
                    android:id="@+id/statusInput"
                    style="@style/HomeRowStatus"
                    android:contentDescription="@string/input" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowLink"
                style="@style/HomeRow">

                <ImageView
                    style="@style/HomeRowIcon"
                    android:src="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/labelLink"
                    style="@style/HomeRowLabel"
                    android:text="@string/link_ready" />

                <ImageView
                    android:id="@+id/statusLink"
                    style="@style/HomeRowStatus"
                    android:contentDescription="@string/link_good" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/home_margin"
        android:layout_marginBottom="16dp"
        android:textColor="#99FFFFFF"
        android:textSize="12sp" />
</FrameLayout>
