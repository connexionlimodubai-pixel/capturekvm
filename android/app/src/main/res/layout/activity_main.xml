<?xml version="1.0" encoding="utf-8"?>
<!--
  One screen, in layers. Later children draw on top and are offered a touch first, so the picture
  is at the bottom, the input surfaces sit over it, the two corner buttons over those, and the
  home screen, the menu and the settings over everything when they are up.

  While streaming there is no bar at all: the picture, and two small round buttons where Steam
  Link keeps its own, the menu at the top left and the keyboard at the top right.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.serenegiant.widget.AspectRatioSurfaceView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Turns touches into relative mouse movement. Hidden in the two controller modes, so a
         stray thumb cannot move the PC's pointer mid-game. -->
    <com.capturekvm.ui.TouchpadView
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The controller drawn over the picture, for a phone with nothing plugged into it. -->
    <com.capturekvm.ui.GamepadView
        android:id="@+id/onscreenPad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Off-screen and one pixel: it exists only to hold focus so the soft keyboard opens and
         its key events reach the activity. -->
    <EditText
        android:id="@+id/keyboardSink"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textVisiblePassword"
        android:background="@null"
        android:cursorVisible="false"
        android:autofillHints=""
        android:contentDescription="@string/keyboard" />

    <!-- Says so while the link is not up, and goes away once it is. Below the on-screen
         controller's top row, not level with it: at 16dp it sat squarely over Back, Guide and
         Start, hiding them just when a dropped link makes you reach for one. -->
    <TextView
        android:id="@+id/streamStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:background="@drawable/pill"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/menuButton"
        style="@style/OverlayButton"
        android:layout_gravity="top|start"
        android:contentDescription="@string/menu"
        android:src="@drawable/ic_more" />

    <ImageButton
        android:id="@+id/streamKeyboard"
        style="@style/OverlayButton"
        android:layout_gravity="top|end"
        android:contentDescription="@string/keyboard"
        android:src="@drawable/ic_keyboard" />

    <include
        android:id="@+id/sessionMenu"
        layout="@layout/view_session_menu" />

    <include
        android:id="@+id/homeScreen"
        layout="@layout/view_home" />

    <include
        android:id="@+id/settingsScreen"
        layout="@layout/view_settings" />
</FrameLayout>
