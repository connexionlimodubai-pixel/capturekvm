<?xml version="1.0" encoding="utf-8"?>
<!-- A tappable line: invisible until pressed or chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/panel_row_pressed" /></shape>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/panel_row" /></shape></item>
            <item android:gravity="start" android:width="3dp">
                <shape android:shape="rectangle"><solid android:color="@color/steam_accent" /></shape>
            </item>
        </layer-list>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#00000000" /></shape></item>
</selector>
